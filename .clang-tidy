---
Checks: |-
  *,
  -misc-include-cleaner
  -misc-non-private-member-variables-in-classes,
  -portability-avoid-pragma-once,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -clang-analyzer-alpha*,
  -*-trailing-return-type,
  -google-*,
  -llvmlibc-*,
  -llvm-include-order,
  -llvm-header-guard,
  -llvm-namespace-comment,
  -clang-analyzer-alpha.core.CastToStruct,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  -clang-analyzer-alpha.deadcode.UnreachableCode,
  -clang-analyzer-core.CallAndMessage,
  -clang-analyzer-core.NonNullParamChecker,
  -modernize-loop-convert,
  -fuchsia-*,
  -hicpp-*,
  -altera-unroll-loops,
  -altera-struct-pack-align,
  -boost-use-ranges,
  -readability-named-parameter,
  -readability-namespace-comments,
  -readability-uppercase-literal-suffix,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-implicit-bool-conversions,
  -readability-implicit-bool-conversion

WarningsAsErrors: ""
HeaderFilterRegex: ".*" # Show warnings from all non-system headers
ExcludeHeaderFilterRegex: 'vulkan/.*\.h$|vk_.*\.h$|.*vulkan.*\.h$'
CheckOptions:
  - key: cert-oop11-cpp.UseCERTSemantics
    value: "1"
  - key: modernize-loop-convert.MaxCopySize
    value: "16"
  - key: modernize-loop-convert.MinConfidence
    value: reasonable
  - key: modernize-loop-convert.NamingStyle
    value: CamelCase
  - key: modernize-pass-by-value.IncludeStyle
    value: llvm
  - key: modernize-replace-auto-ptr.IncludeStyle
    value: llvm
  - key: modernize-use-nullptr.NullMacros
    value: "NULL"
  - key: readability-braces-around-statements.ShortStatementLines
    value: "3"
